<Window x:Class="KolayYazdir.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:KolayYazdir.App.Controls"
        xmlns:vm="clr-namespace:KolayYazdir.App.ViewModels"
        Title="Kolay Yazdır" Height="780" Width="1100" MinHeight="640" MinWidth="920"
        Icon="Assets/kolay-yazdir.ico"
        Background="{StaticResource Background}" AllowDrop="True"
        DragOver="FileList_DragOver" Drop="FileList_Drop"
        FontFamily="{StaticResource AppFont}" FontSize="{StaticResource TextSmall}"
        UseLayoutRounding="True">

  <Window.Resources>
    <vm:TurkishLabelConverter x:Key="Label"/>
  </Window.Resources>

  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{StaticResource Panel}"
            BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="14,10">
      <DockPanel>
        <TextBlock Text="Yazdır" Foreground="{StaticResource PrimaryText}"
                   FontSize="{StaticResource TextLarge}" FontWeight="Medium"/>
        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                   Text="{Binding PrinterStatus}" FontSize="{StaticResource TextSmall}" VerticalAlignment="Center">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="{StaticResource SecondaryText}"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding PrinterIsHealthy}" Value="False">
                  <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Left" Width="270" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,12,14,12">
        <StackPanel>

          <Button Style="{StaticResource AccentButton}" Content="Dosya seç" Click="PickFiles_Click"/>

          <Border Margin="0,12,0,0" BorderBrush="{StaticResource ControlLine}" BorderThickness="1"
                  CornerRadius="10" MinHeight="70" Padding="8">
            <ListBox x:Name="FileList" Background="Transparent" BorderThickness="0"
                     ItemsSource="{Binding Files}" AllowDrop="True"
                     DragOver="FileList_DragOver" Drop="FileList_Drop"
                     PreviewMouseLeftButtonDown="FileList_PreviewMouseLeftButtonDown"
                     PreviewMouseMove="FileList_PreviewMouseMove"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Background" Value="Transparent"/>
                  <Setter Property="Padding" Value="2"/>
                  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <DockPanel ToolTip="{Binding Path}">
                    <Button DockPanel.Dock="Right" Content="✕" Width="24" Height="24"
                            Style="{StaticResource QuietButton}" FontSize="13"
                            Foreground="{StaticResource SecondaryText}"
                            Click="RemoveFile_Click" Tag="{Binding}"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding PageLabel}" FontSize="{StaticResource TextTiny}"
                               Margin="6,0" VerticalAlignment="Center">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{StaticResource SecondaryText}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                              <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding FileName}" FontSize="{StaticResource TextSmall}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="#E8E8E8"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                              <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </DockPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>

          <TextBlock Style="{StaticResource SectionLabel}" Margin="0,14,0,5" Text="Kağıt boyutu"/>
          <controls:SegmentedControl x:Name="PaperSelector" LabelConverter="{StaticResource Label}"
                                     SelectedValue="{Binding PaperSize, Mode=TwoWay}"/>

          <TextBlock Style="{StaticResource SectionLabel}" Margin="0,12,0,5" Text="Yön"/>
          <controls:SegmentedControl x:Name="OrientationSelector" LabelConverter="{StaticResource Label}"
                                     SelectedValue="{Binding Orientation, Mode=TwoWay}"/>

          <TextBlock Style="{StaticResource SectionLabel}" Margin="0,12,0,5" Text="Renk"/>
          <controls:SegmentedControl x:Name="ColorSelector" LabelConverter="{StaticResource Label}"
                                     SelectedValue="{Binding Color, Mode=TwoWay}"/>

          <TextBlock Style="{StaticResource SectionLabel}" Margin="0,12,0,5" Text="Yüz"/>
          <controls:SegmentedControl x:Name="DuplexSelector" LabelConverter="{StaticResource Label}"
                                     SelectedValue="{Binding Duplex, Mode=TwoWay}"/>
          <TextBlock Text="{Binding BindingHint}" Foreground="{StaticResource SecondaryText}"
                     FontSize="{StaticResource TextTiny}" Margin="0,5,0,0" TextWrapping="Wrap"/>

          <TextBlock Style="{StaticResource SectionLabel}" Margin="0,12,0,5" Text="Kağıt cinsi"/>
          <controls:SegmentedControl x:Name="PaperTypeSelector" LabelConverter="{StaticResource Label}"
                                     SelectedValue="{Binding PaperType, Mode=TwoWay}"/>
          <TextBlock Text="{Binding MediaTypeHint}" Foreground="{StaticResource SecondaryText}"
                     FontSize="{StaticResource TextTiny}" Margin="0,5,0,0" TextWrapping="Wrap"/>

          <TextBlock Style="{StaticResource SectionLabel}" Margin="0,12,0,5" Text="Sayfaya yerleşim"/>
          <controls:SegmentedControl x:Name="NUpSelector" LabelConverter="{StaticResource Label}"
                                     SelectedValue="{Binding PagesPerSheet, Mode=TwoWay}"/>

          <CheckBox Margin="0,14,0,0" Content="Sayfaya sığdır" IsChecked="{Binding FitToPage, Mode=TwoWay}"
                    ToolTip="Kapalıyken içerik gerçek boyutunda basılır, sadece taşarsa küçültülür."/>
          <CheckBox Margin="0,8,0,0" Content="İçeriği hücreye göre döndür"
                    IsChecked="{Binding AutoRotate, Mode=TwoWay}"/>

          <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Style="{StaticResource SectionLabel}" Text="Sayfa aralığı"/>
              <TextBox Text="{Binding PageRange, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="Örnek: 1-5, 8, 11-13. Boş bırakılırsa tümü basılır."/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Style="{StaticResource SectionLabel}" Text="Kopya"/>
              <TextBox Text="{Binding Copies, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
          </Grid>

        </StackPanel>
      </ScrollViewer>
    </Border>

    <Grid Background="{StaticResource PreviewBackground}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <DockPanel Grid.Row="0" Margin="12,12,12,8">
        <TextBlock Text="Önizleme" Foreground="{StaticResource SecondaryText}" FontSize="11"
                   VerticalAlignment="Center"/>
        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Text="{Binding SheetLabel}"
                   VerticalAlignment="Center" Foreground="{StaticResource PrimaryText}"
                   FontSize="{StaticResource TextSmall}"/>
      </DockPanel>

      <Border Grid.Row="1" Margin="12,0" Background="{StaticResource PreviewStage}"
              BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6">
        <Grid>
          <Image Source="{Binding PreviewImage}" Margin="20" RenderOptions.BitmapScalingMode="HighQuality"/>
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                      Visibility="{Binding PreviewImage, Converter={StaticResource NullToVisible}}">
            <TextBlock Text="Yazdırmak için dosya seç" Foreground="{StaticResource SecondaryText}"
                       FontSize="{StaticResource TextLarge}" HorizontalAlignment="Center" Margin="0,0,0,18"/>
            <Button Style="{StaticResource AccentButton}" Content="Dosya seç" Click="PickFiles_Click"/>
          </StackPanel>

          <!-- Sayfa okları önizlemenin alt ortasında: fare oradan geçiyor,
               tezgahta hızlı tıklanması gereken yer burası. -->
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                      Margin="0,0,0,14"
                      Visibility="{Binding HasMultipleSheets, Converter={StaticResource BoolToVisible}}">
            <Button Content="‹" Style="{StaticResource PagerButton}"
                    Command="{Binding PreviousSheetCommand}" ToolTip="Önceki sayfa (Sol ok)"/>
            <Button Content="›" Style="{StaticResource PagerButton}" Margin="14,0,0,0"
                    Command="{Binding NextSheetCommand}" ToolTip="Sonraki sayfa (Sağ ok)"/>
          </StackPanel>
        </Grid>
      </Border>

      <DockPanel Grid.Row="2" Margin="12,14,12,12">
        <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource AccentButton}"
                Content="{Binding PrintButtonLabel}" Padding="38,15"
                FontSize="{StaticResource TextLarge}"
                IsEnabled="{Binding IsPrinting, Converter={StaticResource NotBool}}"
                Click="Print_Click"/>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding JobSummary}" Foreground="{StaticResource SecondaryText}"
                     FontSize="{StaticResource TextTiny}"/>
          <TextBlock Text="{Binding LastJobMessage}" Foreground="{StaticResource Accent}"
                     FontSize="{StaticResource TextSmall}" Margin="0,3,0,0"/>
        </StackPanel>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
