<Window x:Class="KolayYazdir.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:KolayYazdir.App.Controls"
        Title="Kolay Yazdır" Height="780" Width="1100" MinHeight="640" MinWidth="920"
        Icon="Assets/kolay-yazdir.ico"
        Background="{StaticResource Background}" AllowDrop="True"
        DragOver="FileList_DragOver" Drop="FileList_Drop"
        FontFamily="{StaticResource AppFont}" FontSize="{StaticResource TextSmall}"
        UseLayoutRounding="True">

  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{StaticResource Panel}"
            BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="14,10">
      <DockPanel>
        <TextBlock Text="Yazdır" Foreground="{StaticResource PrimaryText}"
                   FontSize="{StaticResource TextLarge}" FontWeight="Medium"/>
        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                   Text="{Binding PrinterStatus}" FontSize="{StaticResource TextSmall}" VerticalAlignment="Center">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="{StaticResource SecondaryText}"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding PrinterIsHealthy}" Value="False">
                  <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </DockPanel>
    </Border>

    <Border x:Name="Sidebar" DockPanel.Dock="Left" Width="{x:Static controls:SidebarMetrics.Width}"
            BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <!-- Ayar bloğu sabit, esneyen tek şey dosya listesi: liste uzarsa kendi
           içinde kayar, ayarları aşağı itip gözden kaçırmaz. -->
      <Grid Margin="12,12,14,12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*" MinHeight="{x:Static controls:SidebarMetrics.FileListMinHeight}"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Button x:Name="PickButton" Grid.Row="0" Margin="0,0,0,12"
                Style="{StaticResource AccentButton}" Content="Dosya seç" Click="PickFiles_Click"/>

        <Border Grid.Row="1" BorderBrush="{StaticResource ControlLine}" BorderThickness="1"
                CornerRadius="10" Padding="8">
          <ListBox x:Name="FileList" Background="Transparent" BorderThickness="0"
                   ItemsSource="{Binding Files}" AllowDrop="True"
                   DragOver="FileList_DragOver" Drop="FileList_Drop"
                   PreviewMouseLeftButtonDown="FileList_PreviewMouseLeftButtonDown"
                   PreviewMouseMove="FileList_PreviewMouseMove"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Padding" Value="2"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <DockPanel ToolTip="{Binding Path}">
                  <Button DockPanel.Dock="Right" Content="✕" Width="24" Height="24"
                          Style="{StaticResource QuietButton}" FontSize="13"
                          Foreground="{StaticResource SecondaryText}"
                          Click="RemoveFile_Click" Tag="{Binding}"/>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding PageLabel}" FontSize="{StaticResource TextTiny}"
                             Margin="6,0" VerticalAlignment="Center">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource SecondaryText}"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding HasError}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <TextBlock Text="{Binding FileName}" FontSize="{StaticResource TextSmall}" TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#E8E8E8"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding HasError}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>

        <controls:SettingsPanel x:Name="Settings" Grid.Row="2" Margin="0,12,0,0"/>
      </Grid>
    </Border>

    <Grid Background="{StaticResource PreviewBackground}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <DockPanel Grid.Row="0" Margin="12,12,12,8">
        <TextBlock Text="Önizleme" Foreground="{StaticResource SecondaryText}" FontSize="11"
                   VerticalAlignment="Center"/>
        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Text="{Binding SheetLabel}"
                   VerticalAlignment="Center" Foreground="{StaticResource PrimaryText}"
                   FontSize="{StaticResource TextSmall}"/>
      </DockPanel>

      <Border Grid.Row="1" Margin="12,0" Background="{StaticResource PreviewStage}"
              BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6">
        <Grid>
          <Image Source="{Binding PreviewImage}" Margin="20" RenderOptions.BitmapScalingMode="HighQuality"/>
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                      Visibility="{Binding PreviewImage, Converter={StaticResource NullToVisible}}">
            <TextBlock Text="Yazdırmak için dosya seç" Foreground="{StaticResource SecondaryText}"
                       FontSize="{StaticResource TextLarge}" HorizontalAlignment="Center" Margin="0,0,0,18"/>
            <Button Style="{StaticResource AccentButton}" Content="Dosya seç" Click="PickFiles_Click"/>
          </StackPanel>

          <!-- Sayfa okları önizlemenin alt ortasında: fare oradan geçiyor,
               tezgahta hızlı tıklanması gereken yer burası. -->
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                      Margin="0,0,0,14"
                      Visibility="{Binding HasMultipleSheets, Converter={StaticResource BoolToVisible}}">
            <Button Content="‹" Style="{StaticResource PagerButton}"
                    Command="{Binding PreviousSheetCommand}" ToolTip="Önceki sayfa (Sol ok)"/>
            <Button Content="›" Style="{StaticResource PagerButton}" Margin="14,0,0,0"
                    Command="{Binding NextSheetCommand}" ToolTip="Sonraki sayfa (Sağ ok)"/>
          </StackPanel>
        </Grid>
      </Border>

      <DockPanel Grid.Row="2" Margin="12,14,12,12">
        <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource AccentButton}"
                Content="{Binding PrintButtonLabel}" Padding="38,15"
                FontSize="{StaticResource TextLarge}"
                IsEnabled="{Binding IsPrinting, Converter={StaticResource NotBool}}"
                Click="Print_Click"/>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding JobSummary}" Foreground="{StaticResource SecondaryText}"
                     FontSize="{StaticResource TextTiny}"/>
          <TextBlock Text="{Binding LastJobMessage}" Foreground="{StaticResource Accent}"
                     FontSize="{StaticResource TextSmall}" Margin="0,3,0,0"/>
        </StackPanel>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
